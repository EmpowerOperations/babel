*.jar filter=lfs diff=lfs merge=lfs -text

# Askama templates are embedded verbatim and rendered into program output, so
# their line endings are data rather than source formatting. Without this,
# autocrlf gives Windows a CRLF prelude and Linux an LF one, and the emitted
# SMT-LIB document is not byte-identical across platforms.
*.jinja text eol=lf
