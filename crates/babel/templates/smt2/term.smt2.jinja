{%- import "smt2/operators.smt2.jinja" as ops -%}
{#-
  One SMT-LIB term. Children arrive already rendered, so every arm closes
  the parenthesis it opens and a term is balanced by construction; nesting is
  the walk's business, in `emit.rs`.

  Symbols are always quoted: babel identifiers may be any Unicode — the corpus
  has emoji and Han characters — and a quoted symbol accepts anything but `|`
  and `\`, neither of which babel's lexer admits. A negative number is the
  operator `-` applied to a literal, not part of the literal. `a == b +/- t`
  is two bounds `and`-ed rather than a `max` — SMT-LIB has no absolute value,
  and a conjunction of linear bounds is the easiest shape a solver can be
  given. `let` nests one binding per form, innermost last.
-#}
{%- match self -%}
{%- when Term::Symbol with (name) -%}|{{ name }}|
{%- when Term::Local with (slot) -%}l{{ slot }}
{%- when Term::Real with (digits) -%}{{ digits }}
{%- when Term::NegativeReal with (digits) -%}(- {{ digits }})
{%- when Term::Unary with (op, a) -%}{{ ops::unary(op, a) }}
{%- when Term::Binary with (op, a, b) -%}{{ ops::binary(op, a, b) }}
{%- when Term::Relation with (op, a, b) -%}{{ ops::relation(op, a, b) }}
{%- when Term::Fold with (kind, terms) -%}{{ ops::fold(kind, terms) }}
{%- when Term::And with (terms) -%}(and{% for t in terms %} {{ t }}{% endfor %})
{%- when Term::NearEq with (left, right, bound) -%}
(and (<= (- {{ left }} {{ right }}) {{ bound }}) (>= (- {{ left }} {{ right }}) (- {{ bound }})))
{%- when Term::Let with (slot, value, body) -%}(let ((l{{ slot }} {{ value }})) {{ body }})
{%- endmatch -%}
