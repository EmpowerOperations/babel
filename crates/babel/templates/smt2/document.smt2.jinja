{#-
  The whole document. One command per line, and this template owns every
  newline: a `;` comment runs to the end of its line, so a comment without a
  newline after it would eat the next command, quietly — the parse guard in
  `smt.rs` fires only when *every* assertion is lost. The constraint sources
  arrive whitespace-collapsed for the same reason.

  `set-option` before `set-logic`, which is where SMT-LIB wants options;
  asking for unsat cores up front costs nothing on a satisfiable query and is
  the only way to learn *which* constraints conflict on an unsatisfiable one.
  Each assertion is named `cN` so the core points back at the constraint the
  author wrote; a constraint that could not be translated leaves a gap in the
  numbering, which is what keeps the core honest.

  This file ends in two line breaks on purpose: askama drops one trailing
  newline from a template, and the document must end with exactly one. A
  comment placed after `(get-model)` would strip it again.
-#}
(set-option :produce-unsat-cores true)
(set-logic {{ logic }})
{{ prelude }}
{%- for v in inputs %}
(declare-const {{ v.symbol }} Real)
{%- endfor %}
{%- for v in inputs %}
{%- if let Some(b) = v.bounds %}
(assert (and (>= {{ v.symbol }} {{ b.low }}) (<= {{ v.symbol }} {{ b.high }})))
{%- endif %}
{%- endfor %}
{%- for c in constraints %}
; {{ c.source }}
{%- match c.outcome %}
{%- when Ok with (a) %}
{%- for condition in a.conditions %}
{{ condition }}
{%- endfor %}
(assert (! {{ a.claim }} :named {{ c.name }}))
{%- when Err with (why) %}
; {{ why }}
{%- endmatch %}
{%- endfor %}
(check-sat)
(get-model)

