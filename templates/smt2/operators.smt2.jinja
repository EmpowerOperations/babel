{#-
  How each babel operator is spelled in SMT-LIB, one macro arm per variant.
  The operands arrive rendered, so an arm only wraps them.

  The operator types here are `SmtUnary` and `SmtBinary`, the subsets of
  babel's operators that SMT-LIB can spell for `Real`: the transcendentals,
  `Pow` and `LogB` are not in them, so the walk in `emit.rs` has to refuse
  those before it can ask for a term, and a variant added to either type
  without an arm here is a compile error.
-#}
{%- macro unary(op, a) -%}
{%- match op -%}
{%- when SmtUnary::Negate -%}(- {{ a }})
{%- when SmtUnary::Abs -%}(babel_abs {{ a }})
{%- when SmtUnary::Sqr -%}(babel_sqr {{ a }})
{%- when SmtUnary::Cube -%}(babel_cube {{ a }})
{%- when SmtUnary::Sgn -%}(babel_sgn {{ a }})
{%- when SmtUnary::Floor -%}(babel_floor {{ a }})
{%- when SmtUnary::Ceil -%}(babel_ceil {{ a }})
{%- endmatch -%}
{%- endmacro -%}

{#- `%` goes through `babel_rem` — `a - b*trunc(a/b)`, Java's sign rule —
  because SMT-LIB's own `mod` is integer-only. -#}
{%- macro binary(op, a, b) -%}
{%- match op -%}
{%- when SmtBinary::Add -%}(+ {{ a }} {{ b }})
{%- when SmtBinary::Sub -%}(- {{ a }} {{ b }})
{%- when SmtBinary::Mul -%}(* {{ a }} {{ b }})
{%- when SmtBinary::Div -%}(/ {{ a }} {{ b }})
{%- when SmtBinary::Rem -%}(babel_rem {{ a }} {{ b }})
{%- when SmtBinary::Max -%}(babel_max {{ a }} {{ b }})
{%- when SmtBinary::Min -%}(babel_min {{ a }} {{ b }})
{%- endmatch -%}
{%- endmacro -%}

{#- A comparison is emitted as the comparison the author wrote; strictness
  is the relation, not a nudge. -#}
{%- macro relation(op, a, b) -%}
{%- match op -%}
{%- when CompareOp::Lt -%}(< {{ a }} {{ b }})
{%- when CompareOp::Lte -%}(<= {{ a }} {{ b }})
{%- when CompareOp::Gt -%}(> {{ a }} {{ b }})
{%- when CompareOp::Gte -%}(>= {{ a }} {{ b }})
{%- endmatch -%}
{%- endmacro -%}

{#- An unrolled aggregate is one n-ary application; SMT-LIB's `+` and `*`
  take any number of arguments from two up. -#}
{%- macro fold(kind, terms) -%}
{%- match kind -%}
{%- when AggregateKind::Sum -%}(+{% for t in terms %} {{ t }}{% endfor %})
{%- when AggregateKind::Prod -%}(*{% for t in terms %} {{ t }}{% endfor %})
{%- endmatch -%}
{%- endmacro -%}
